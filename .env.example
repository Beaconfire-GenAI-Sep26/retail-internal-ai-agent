# Copy this file to .env and replace the password before starting Compose.
# .env is local runtime configuration and is excluded from Git and image builds.
APP_PORT=18080
APP_ENV=local
LOG_LEVEL=info
POSTGRES_DB=retail_agent
POSTGRES_USER=retail_app
POSTGRES_PASSWORD=replace-with-your-local-password
AUTH_DB_PASSWORD=replace-with-your-auth-db-password
DOMAIN_DB_PASSWORD=replace-with-your-domain-db-password
AGENT_DB_PASSWORD=replace-with-your-agent-db-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=mi-auth
JWT_TTL_MINUTES=60
REFRESH_TTL_DAYS=7
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-secret
# false only for this localhost HTTP demo; HTTPS deployments must use true.
COOKIE_SECURE=false
# Optional canonical browser origin, e.g. https://retail.example.com
PUBLIC_ORIGIN=
SEED_AUTH_ACCOUNTS=true
SEED_ANALYST_PASSWORD=Password123!
SEED_VIEWER_PASSWORD=Password123!

# Agent model and optional Langfuse Cloud tracing (server-side only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
# For the trace POC --domain http only: a fresh analyst JWT and reachable Domain URL.
POC_ACCESS_TOKEN=
DOMAIN_SERVICE_URL=http://localhost:8000
