# Copy this file to .env and replace each password before starting Compose.
# .env is local runtime configuration and is excluded from Git and image builds.
APP_PORT=18080
POSTGRES_DB=retail_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-admin-password
AUTH_DB_PASSWORD=replace-with-your-local-auth-password
AGENT_DB_PASSWORD=replace-with-your-local-agent-password
DOMAIN_DB_PASSWORD=replace-with-your-local-domain-password
EVAL_DB_PASSWORD=replace-with-your-local-evaluation-password
MIGRATION_DB_PASSWORD=replace-with-your-local-migration-password
