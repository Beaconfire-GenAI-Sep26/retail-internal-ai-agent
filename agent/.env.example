# Copy this file to agent/.env and fill in the values before running the service,
# the CLI smoke run or the M0 spike. agent/.env is git-ignored. Never commit real keys.

APP_ENV=local
LOG_LEVEL=info
ROOT_PATH=/agent

# Claude API. Required for real reason turns (CLI smoke run, M0 spike, the API in any mode).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. M0 measures low, medium and high.
AGENT_EFFORT=medium
# standard | fast. fast costs about 2x.
AGENT_SPEED=standard

# Investigation limits
AGENT_MAX_STEPS=12
AGENT_MAX_RETRIES=2
AGENT_RUN_TIMEOUT_SECONDS=1200
AGENT_MAX_QUESTIONS=2

# fixtures: answer Domain calls from tests/fixtures/domain (no Domain Service needed).
# http: call the Domain Service at DOMAIN_SERVICE_URL.
AGENT_DOMAIN_MODE=fixtures
DOMAIN_SERVICE_URL=http://domain:8000
INTERNAL_SERVICE_TOKEN=change-me-internal

# Must match the Auth Service.
JWT_SECRET=change-me-32-bytes-min-local-only
JWT_ISSUER=mi-auth

# memory, or postgres so a paused run survives a restart (Compose uses postgres).
# For postgres here, set DATABASE_URL as role agent_svc. Compose passes POSTGRES_* in the environment instead.
AGENT_CHECKPOINTER=memory
DATABASE_URL=

# Langfuse tracing (M2). Empty keys turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
