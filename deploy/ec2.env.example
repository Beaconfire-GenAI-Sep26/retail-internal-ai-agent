# Copy to .env on a fresh EC2 installation; replace every credential placeholder.
# Do not replace an existing server .env during upgrades.
DOCKERHUB_IMAGE=yourusername/retail
IMAGE_TAG=1.0.1

# The Agent accepts local, ci, or demo; use demo for this EC2 deployment.
APP_ENV=demo
LOG_LEVEL=info
APP_PORT=18080
HTTP_PORT=80
POSTGRES_DB=retail_agent
POSTGRES_USER=retail_app
POSTGRES_PASSWORD=replace-with-random-admin-password
AUTH_DB_PASSWORD=replace-with-random-auth-db-password
DOMAIN_DB_PASSWORD=replace-with-random-domain-db-password
AGENT_DB_PASSWORD=replace-with-random-agent-db-password
MIGRATION_DB_PASSWORD=
EVAL_DB_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=mi-auth
JWT_TTL_MINUTES=60
REFRESH_TTL_DAYS=7
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token

# Default: browser localhost:18081 -> SSH tunnel -> EC2 localhost:18080.
# For HTTPS, use COOKIE_SECURE=true and PUBLIC_ORIGIN=https://your-domain.
# For the optional HTTP demo, PUBLIC_ORIGIN must be http://EC2_PUBLIC_IP.
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:18081
SEED_AUTH_ACCOUNTS=true
SEED_ANALYST_PASSWORD=replace-with-a-strong-analyst-password
SEED_VIEWER_PASSWORD=replace-with-a-strong-viewer-password

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional tracing. Set both keys and enable only if configured.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
