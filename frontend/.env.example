# Copy to .env for local dev. Only VITE_* variables reach the browser code.

# API Gateway base URL — empty = same origin (Docker build)
VITE_API_URL=

# true = log in with mock accounts (src/api/mockAuth.js) until A-02 is ready
VITE_USE_MOCKS=true

# Local dev only: real JWTs so mock login can call a locally running Domain API.
# Generate in domain/:  python -m scripts.make_demo_token --stores STORE-A STORE-B
#                       python -m scripts.make_demo_token --role viewer --stores STORE-A
VITE_DEV_TOKEN_ANALYST=
VITE_DEV_TOKEN_VIEWER=
